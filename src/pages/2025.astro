        opacity: 0 !important;
        transform: translateY(8px) scale(0.985) !important;
        transition-duration: 0.25s !important;
    }
    .yr-dot {
        position: absolute;
        left: calc(-1 * clamp(1.6rem, 3vw, 2.4rem) - 5px + 2.5px);
        top: clamp(1.8rem, 3.4vh, 2.4rem);
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.28);
        transform: translateX(-50%);
        transition: background-color 0.4s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .yr-dot.is-lit,
    .yr-moment:hover .yr-dot,
    .yr-moment:focus-within .yr-dot {
        background: #fe7743;
        transform: translateX(-50%) scale(1.5);
    }
    .yr-moment-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.7rem;
        margin-bottom: 0.55rem;
    }
    .yr-moment-meta time {
        font-family: "Geist", sans-serif;
        font-size: 0.7rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #ffffff9e;
        font-variant-numeric: tabular-nums;
        transition: color 0.3s;
    }
    .yr-moment:hover .yr-moment-meta time {
        color: #ffffffe0;
    }
    .yr-tag {
        font-family: "Geist", sans-serif;
        font-size: 0.62rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #ffffff47;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 9999px;
        padding: 0.18rem 0.6rem;
    }
    .yr-tag-dim {
        color: #ffffff2e;
        border-style: dashed;
    }
    .yr-first {
        font-family: "Geist", sans-serif;
        font-size: 0.62rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #fe7743;
    }
    .yr-moment-title {
        font-family: "Instrument Serif", serif;
        font-style: italic;
        font-weight: 400;
        font-size: clamp(1.4rem, 2.8vw, 2rem);
        line-height: 1.12;
        color: #ffffffe0;
        margin: 0;
    }
    .yr-moment-title a {
        color: inherit;
        text-decoration: none;
        background-image: linear-gradient(currentColor, currentColor);
        background-repeat: no-repeat;
        background-position: left bottom;
        background-size: 0% 1px;
        transition: color 0.25s, background-size 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .yr-moment-title a:hover {
        color: #fff;
        background-size: 100% 1px;
    }
    .yr-moment-desc {
        font-family: "Geist", sans-serif;
        font-size: 0.86rem;
        line-height: 1.55;
        letter-spacing: 0.02em;
        color: #fff6;
        max-width: 26rem;
        margin: 0.55rem 0 0;
    }
    .yr-moment-img.is-contain img {
        object-fit: contain;
        padding: 18%;
        filter: none;
        opacity: 0.5;
        transform: none;
    }
    .yr-moment-img.is-contain::after {
        display: none;
    }
    .yr-moment:hover .yr-moment-img.is-contain img {
        opacity: 0.8;
        filter: none;
        transform: none;
    }
    .yr-stat {
        display: inline-block;
        margin-top: 0.7rem;
        font-family: "Geist", sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #ffffff9e;
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
        padding-bottom: 0.25rem;
    }
    .yr-moment-img {
        position: relative;
        display: block;
        border-radius: 0.8rem;
        overflow: hidden;
        aspect-ratio: 16 / 10;
        background: rgba(255, 255, 255, 0.03);
    }
    .yr-moment-img::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, #000000b8, #00000040 45%, #0000000d);
        pointer-events: none;
    }
    .yr-moment-img.is-poster img {
        filter: brightness(0.5) saturate(0.55);
    }
    .yr-moment-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: var(--img-filter);
        transform: scale(1.06);
        transition:
            filter 0.6s cubic-bezier(0.2, 0.85, 0.25, 1),
            transform 0.6s cubic-bezier(0.2, 0.85, 0.25, 1);
    }
    .yr-moment:hover .yr-moment-img img {
        filter: brightness(0.88) saturate(1);
        transform: scale(1);
    }

    /* ── More ledger ── */
    .yr-more {
        position: relative;
        z-index: 1;
        border-top: 1px solid var(--yr-hair);
    }
    .yr-more summary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        list-style: none;
        cursor: pointer;
        font-family: "Geist", sans-serif;
        font-size: 0.72rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #ffffff47;
        padding: 1rem 0;
        transition: color 0.25s;
    }
    .yr-more summary::-webkit-details-marker {
        display: none;
    }
    .yr-more summary:hover {
        color: rgba(255, 255, 255, 0.62);
    }
    .yr-more summary svg {
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .yr-more[open] summary svg {
        transform: rotate(45deg);
    }
    .yr-more-body {
        padding-bottom: 0.8rem;
    }
    .yr-more-title {
        font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    }
    @supports (interpolate-size: allow-keywords) {
        .yr-more {
            interpolate-size: allow-keywords;
        }
        .yr-more::details-content {
            opacity: 0;
            block-size: 0;
            overflow-y: clip;
            transition: content-visibility 0.4s allow-discrete, opacity 0.4s, block-size 0.4s;
        }
        .yr-more[open]::details-content {
            opacity: 1;
            block-size: auto;
        }
    }

    /* ── Quotes ── */
    .yr-quote {
        position: relative;
        margin: clamp(3rem, 8vh, 5.5rem) 0;
        padding-left: 2rem;
    }
    .yr-quote-left {
        padding-left: max(2rem, 8%);
    }
    .yr-quote-right {
        padding-left: max(2rem, 30%);
    }
    .yr-quote-charter {
        margin-top: clamp(4rem, 10vh, 7rem);
    }
    .yr-quote[data-reveal] {
        opacity: 1;
        transform: none;
    }
    .yr-quote-star {
        position: absolute;
        left: 0;
        top: 0.5em;
        width: 0.9rem;
        height: 0.9rem;
        color: #fe7743;
    }
    .yr-quote-right .yr-quote-star {
        left: calc(max(2rem, 30%) - 2rem);
    }
    .yr-quote-left .yr-quote-star {
        left: calc(max(2rem, 8%) - 2rem);
    }
    .yr-quote blockquote {
        margin: 0;
        font-family: "Instrument Serif", serif;
        font-style: italic;
        font-size: clamp(1.7rem, 4vw, 2.8rem);
        line-height: 1.2;
        color: #ffffffe0;
        max-width: 24ch;
    }
    .yr-q-line {
        display: block;
        overflow: hidden;
    }
    .yr-q-line > span {
        display: block;
        transform: translateY(110%);
        transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: calc(var(--l, 0) * 0.1s);
    }
    .is-revealed .yr-q-line > span {
        transform: none;
    }
    .yr-quote figcaption {
        margin-top: 1rem;
        font-family: "Geist", sans-serif;
        font-size: 0.68rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #ffffff47;
    }

    /* ── Firsts grid ── */
    .yr-section-title {
        font-family: "Instrument Serif", serif;
        font-style: italic;
        font-weight: 400;
        font-size: clamp(1.5rem, 2.8vw, 2.2rem);
        color: #ffffffe0;
        margin: 0 0 clamp(1.5rem, 3vh, 2.2rem);
    }
    .yr-firsts {
        padding-top: clamp(3rem, 7vh, 5rem);
    }
    .yr-firsts-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid var(--yr-hair);
        border-left: 1px solid var(--yr-hair);
    }
    .yr-first-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: clamp(1.3rem, 2.6vw, 2rem);
        border-right: 1px solid var(--yr-hair);
        border-bottom: 1px solid var(--yr-hair);
        transition-delay: calc(var(--i, 0) * 80ms);
    }
    .yr-first-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        opacity: 0;
        filter: var(--img-filter) brightness(0.45);
        transition: opacity 0.5s cubic-bezier(0.2, 0.85, 0.25, 1);
        pointer-events: none;
    }
    .yr-first-card::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        background: linear-gradient(to top, #0f0e0c 10%, #0f0e0cb0);
        opacity: 0;
        transition: opacity 0.5s cubic-bezier(0.2, 0.85, 0.25, 1);
        pointer-events: none;
    }
    @media (hover: hover) {
        .yr-first-card:hover .yr-first-bg,
        .yr-first-card:hover::after {
            opacity: 1;
        }
    }
    .yr-first-card > span {
        position: relative;
        z-index: 1;
    }
    .yr-first-star {
        color: #fe7743;
        font-size: 0.85rem;
        margin-bottom: 0.3rem;
    }
    [data-reveal].yr-first-card .yr-first-star {
        opacity: 0;
        transform: scale(0.5) rotate(-45deg);
        transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: calc(var(--i, 0) * 80ms + 0.25s);
    }
    [data-reveal].yr-first-card.is-revealed .yr-first-star {
        opacity: 1;
        transform: none;
    }
    .yr-first-label {
        font-family: "Instrument Serif", serif;
        font-style: italic;
        font-size: clamp(1.1rem, 2vw, 1.35rem);
        color: #ffffffe0;
        line-height: 1.2;
    }
    .yr-first-detail {
        font-family: "Geist", sans-serif;
        font-size: 0.8rem;
        line-height: 1.5;
        color: #fff6;
    }
    .yr-first-date {
        font-family: "Geist", sans-serif;
        font-size: 0.66rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #ffffff47;
        margin-top: auto;
        padding-top: 0.5rem;
    }

    /* ── Film strip ── */
    .yr-strip {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-top: clamp(3.5rem, 8vh, 6rem);
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
        mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    }
    .yr-strip-track {
        display: flex;
        gap: 0.5rem;
        width: max-content;
        animation: yr-marquee 70s linear infinite;
    }
    .yr-strip:hover .yr-strip-track,
    .yr-strip-track.is-paused {
        animation-play-state: paused;
    }
    .yr-strip-btn {
        padding: 0;
        border: none;
        background: none;
        cursor: zoom-in;
        border-radius: 0.6rem;
        overflow: hidden;
        flex-shrink: 0;
    }
    .yr-strip-btn img {
        display: block;
        height: clamp(150px, 22vw, 230px);
        width: auto;
        filter: brightness(0.62) saturate(0.8);
        transition: filter 0.5s cubic-bezier(0.2, 0.85, 0.25, 1);
    }
    .yr-strip-btn:hover img,
    .yr-strip-btn:focus-visible img {
        filter: brightness(0.95) saturate(1);
    }
    @keyframes yr-marquee {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

    /* ── Lightbox ── */
    .yr-lightbox {
        background: transparent;
        border: none;
        padding: 0;
        max-width: min(94vw, 1100px);
        outline: none;
    }
    .yr-lightbox::backdrop {
        background: rgba(15, 14, 12, 0.95);
    }
    .yr-lightbox figure {
        margin: 0;
    }
    .yr-lightbox img {
        display: block;
        max-width: 100%;
        max-height: 74vh;
        margin: 0 auto;
        border-radius: 0.8rem;
        opacity: 0;
        transform: scale(0.985);
    }
    .yr-lightbox img.is-in {
        opacity: 1;
        transform: none;
        transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .yr-lightbox figcaption {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.9rem;
        font-family: "Geist", sans-serif;
        font-size: 0.7rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #ffffff9e;
    }
    .yr-lb-count {
        font-variant-numeric: tabular-nums;
        color: #ffffff47;
    }
    .yr-lb-controls {
        display: flex;
        justify-content: center;
        gap: 0.6rem;
        margin-top: 1.1rem;
    }

    /* ── Growth ── */
    .yr-growth {
        padding-top: clamp(2rem, 5vh, 3.5rem);
    }
    .yr-growth-sub {
        font-family: "Geist", sans-serif;
        font-size: 0.9rem;
        line-height: 1.7;
        color: #fff6;
        max-width: 34rem;
        margin: -0.8rem 0 clamp(1.8rem, 4vh, 2.6rem);
    }
    .yr-gline-wrap {
        border-top: 1px solid var(--yr-hair);
        padding-top: clamp(1.4rem, 3vh, 2rem);
    }
    .yr-gline {
        width: 100%;
        height: clamp(120px, 22vw, 220px);
        display: block;
        overflow: visible;
    }
    .yr-gline-path {
        fill: none;
        stroke: rgba(254, 119, 67, 0.55);
        stroke-width: 1.5;
        vector-effect: non-scaling-stroke;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
    }
    .is-revealed .yr-gline-path {
        stroke-dashoffset: 0;
        transition: stroke-dashoffset 1.8s cubic-bezier(0.2, 0.85, 0.25, 1) 0.2s;
    }
    .yr-gline-marker {
        fill: rgba(255, 255, 255, 0.55);
        opacity: 0;
        transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: var(--d, 0.4s);
    }
    .yr-gline-marker[data-final] {
        fill: #fe7743;
    }
    .is-revealed .yr-gline-marker {
        opacity: 1;
    }
    .yr-growth-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        border-bottom: 1px solid var(--yr-hair);
        padding: clamp(0.8rem, 2vh, 1.4rem) 0 clamp(1.4rem, 3vh, 2rem);
    }
    .yr-growth-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .yr-growth-item:last-child {
        text-align: right;
    }
    .yr-growth-value {
        font-family: "Geist", sans-serif;
        font-weight: 700;
        font-size: clamp(1.2rem, 2.6vw, 1.9rem);
        color: #ffffffd1;
        font-variant-numeric: tabular-nums;
        display: inline-block;
    }
    .yr-growth-value.is-settled {
        animation: yr-settle 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .yr-growth-label {
        font-family: "Geist", sans-serif;
        font-size: 0.66rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: rgba(255, 255, 255, 0.4);
    }
    .yr-growth-date {
        font-family: "Geist", sans-serif;
        font-size: 0.66rem;
        color: #ffffff47;
    }

    /* ── Pulse ── */
    .yr-pulse {
        padding-top: clamp(1.6rem, 3.5vh, 2.4rem);
    }
    .yr-pulse-readout {
        font-family: "Geist", sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        color: #ffffff47;
        margin: 0 0 0.9rem;
        min-height: 1em;
    }
    .yr-pulse-strip {
        display: flex;
        align-items: flex-end;
        gap: 0.35rem;
        height: 110px;
    }
    .yr-pulse-bar {
        flex: 1;
        min-width: 24px;
        height: 100%;
        display: flex;
        align-items: flex-end;
        padding: 0;
        background: none;
        border: none;
        cursor: pointer;
    }
    .yr-pulse-bar span {
        display: block;
        width: 100%;
        height: max(calc(var(--h) * 100%), 2px);
        background: rgba(255, 255, 255, 0.14);
        border-radius: 1px;
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s;
        transition-delay: calc(var(--i, 0) * 40ms);
    }
    .is-revealed .yr-pulse-bar span {
        transform: none;
    }
    .yr-pulse-bar:hover span,
    .yr-pulse-bar:focus-visible span {
        background: rgba(255, 255, 255, 0.3);
    }
    .yr-pulse-bar[data-peak] span {
        background: rgba(254, 119, 67, 0.45);
    }
    .yr-pulse-bar[data-peak]:hover span,
    .yr-pulse-bar[data-peak]:focus-visible span {
        background: rgba(254, 119, 67, 0.7);
    }
    .yr-pulse-meta {
        font-family: "Geist", sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        color: #ffffff47;
        font-variant-numeric: tabular-nums;
        margin: 1rem 0 0;
    }

    /* ── Ahead ── */
    .yr-ahead {
        padding-top: clamp(3.5rem, 8vh, 6rem);
    }
    .yr-ahead-list {
        border-top: 1px solid var(--yr-hair);
    }
    .yr-ahead-row {
        display: grid;
        grid-template-columns: 0.35fr 0.85fr 1fr;
        gap: 1rem;
        align-items: baseline;
        padding: 1.1rem 0;
        border-bottom: 1px solid var(--yr-hair);
        transition: border-color 0.3s;
    }
    .yr-ahead-row:hover {
        border-bottom-color: var(--yr-hair-hover);
    }
    .yr-ahead-date {
        font-family: "Geist", sans-serif;
        font-size: 0.7rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #ffffff9e;
        font-variant-numeric: tabular-nums;
    }
    .yr-ahead-title {
        font-family: "Instrument Serif", serif;
        font-style: italic;
        font-size: clamp(1.05rem, 2vw, 1.3rem);
        color: #ffffffe0;
    }
    .yr-ahead-note {
        font-family: "Geist", sans-serif;
        font-size: 0.78rem;
        color: #fff6;
    }

    /* ── Constellation ── */
    .yr-sky {
        position: relative;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-top: clamp(3rem, 7vh, 5rem);
        min-height: 100dvh;
        overflow: hidden;
    }
    .yr-sky[data-reveal] {
        opacity: 1;
        transform: none;
    }
    .yr-sky-lines {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }
    .yr-sky-lines line {
        stroke: rgba(255, 255, 255, 0.08);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
    }
    .is-revealed .yr-sky-lines line {
        stroke-dashoffset: 0;
        transition: stroke-dashoffset 1.2s cubic-bezier(0.2, 0.85, 0.25, 1);
        transition-delay: var(--d, 0.8s);
    }
    .yr-sky-star {
        position: absolute;
        transform: translate(-50%, -50%);
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        padding: 0;
        background: none;
        border: none;
        cursor: pointer;
        opacity: 0;
        scale: 0.5;
        transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), scale 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: calc(var(--i, 0) * 60ms);
    }
    .is-revealed .yr-sky-star {
        opacity: 1;
        scale: 1;
    }
    .yr-sky-star svg {
        width: 11px;
        height: 11px;
        color: rgba(255, 255, 255, 0.55);
        transition: color 0.3s, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .yr-sky-star:nth-child(3n) svg {
        color: rgba(255, 255, 255, 0.4);
    }
    .yr-sky-star:nth-child(4n) svg {
        color: rgba(255, 255, 255, 0.7);
    }
    .yr-sky-star:hover svg,
    .yr-sky-star:focus-visible svg {
        color: #fff;
        transform: scale(1.35);
    }
    .yr-sky-north svg {
        width: 18px;
        height: 18px;
        color: #fe7743 !important;
    }
    .yr-sky-label {
        position: absolute;
        bottom: calc(100% + 0.35rem);
        left: 50%;
        transform: translateX(-50%) translateY(4px);
        white-space: nowrap;
        font-family: "Geist", sans-serif;
        font-size: 0.62rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #ffffffe0;
        background: rgba(15, 14, 12, 0.92);
        border: 1px solid var(--yr-hair);
        border-radius: 9999px;
        padding: 0.35rem 0.7rem;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 5;
    }
    .yr-sky-label em {
        font-style: normal;
        color: #ffffff47;
