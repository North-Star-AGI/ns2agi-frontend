const gMax = Math.sqrt(2000);
const gy = growth.map((g) => 190 - (Math.sqrt(g.value) / gMax) * 160);
const growthPath = `M${gx[0]},${gy[0].toFixed(1)} C${gx[0] + 120},${(gy[0] - 14).toFixed(1)} ${gx[1] - 120},${(gy[1] + 10).toFixed(1)} ${gx[1]},${gy[1].toFixed(1)} S${gx[2] - 120},${(gy[2] + 12).toFixed(1)} ${gx[2]},${gy[2].toFixed(1)}`;
---

<Layout title="Year One · 2025 | North Star">
    <main class="yr-page">
        <a class="yr-skip" href="#yr-timeline">Skip to the timeline</a>

        <!-- ── Hero ── -->
        <header class="yr-hero">
            <div class="yr-hero-bleed" aria-hidden="true">
                <img src="/2025/ai-hackathon-ii-4.jpg" alt="" decoding="async" fetchpriority="high" />
            </div>
            <span class="yr-ghost" data-hero-ghost aria-hidden="true">2025</span>
            <div class="yr-hero-inner">
                <p class="yr-eyebrow"><span class="yr-mask" style="--i:0"><span>North Star · Year in review</span></span></p>
                <h1 class="yr-title"><span class="yr-mask" style="--i:1"><span>Year One</span></span></h1>
                <p class="yr-sub">
                    <span class="yr-mask" style="--i:2"><span>
                        An idea and a Discord server became Belgium’s AI &amp; robotics
                        community — in {totalMoments} moments.
                    </span></span>
                </p>
                <div class="yr-scroll-cue" aria-hidden="true"><span></span></div>
            </div>
        </header>

        <!-- ── Proof bar ── -->
        <section class="yr-proof" data-reveal aria-label="Key numbers">
            {stats.map((s, i) => (
                <>
                    {i > 0 && <span class="yr-proof-sep" aria-hidden="true"></span>}
                    <div class="yr-proof-item">
                        <span class="yr-proof-value" data-count={s.value} data-suffix={s.suffix} data-idx={i}>0{s.suffix}</span>
                        <span class="yr-proof-label">{s.label}</span>
                    </div>
                </>
            ))}
        </section>

        <!-- ── Filters + timeline zone (bounds the sticky chips) ── -->
        <div class="yr-zone">
        <nav class="yr-filters" data-reveal aria-label="Filter the timeline">
            <div class="yr-chip-row">
                {filters.map((f) => (
                    <button
                        type="button"
                        class="yr-chip"
                        data-filter={f.key}
                        aria-pressed={f.key === "all" ? "true" : "false"}
                    >{f.label}<span class="yr-chip-count">{tagCounts[f.key] ?? 0}</span></button>
                ))}
            </div>
            <p class="yr-filter-readout yr-visually-hidden" aria-live="polite">Showing all {totalMoments} moments across three chapters.</p>
        </nav>

        <div class="yr-body">
            <aside class="yr-rail" aria-label="Chapters">
                {chapters.map((c) => (
                    <a href={`#${c.id}`} class="yr-rail-link" data-rail={c.id}>
                        <span class="yr-rail-numeral">{c.numeral}</span>
                        <span class="yr-rail-meta">
                            <span class="yr-rail-title">{c.title}</span>
                            <span class="yr-rail-period">{c.period}</span>
                        </span>
                    </a>
                ))}
            </aside>

            <div class="yr-timeline" id="yr-timeline" tabindex="-1">
                <div class="yr-line" aria-hidden="true">
                    <div class="yr-line-trail"></div>
                    <svg class="yr-line-star" viewBox="0 0 24 24" fill="none">
                        <g class="yr-star-core">
                            <path d={STAR_PATH} fill="currentColor" />
                        </g>
                    </svg>
                </div>

                {chapters.map((c) => (
                    <>
                    <section class="yr-chapter" id={c.id} data-chapter={c.id}>
                        <span class="yr-chapter-ghost" data-parallax="0.15" aria-hidden="true">{c.numeral}</span>
                        <header class="yr-chapter-head" data-reveal>
                            <span class="yr-chapter-numeral">Chapter {c.numeral}</span>
                            <h2 class="yr-chapter-title">{c.title}
                                <button type="button" class="yr-anchor" data-anchor={c.id} aria-label={`Copy link to chapter ${c.numeral}`}>
                                    <span class="yr-swap">
                                        <span class="yr-swap-a"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg></span>
                                        <span class="yr-swap-b"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 6L9 17l-5-5"/></svg></span>
                                    </span>
                                </button>
                            </h2>
                            <span class="yr-chapter-period">{c.period}</span>
                        </header>

                        {c.moments.map((m) => (
                            <article class={`yr-moment${m.image ? " has-image" : ""}`} data-tag={m.tag} data-reveal>
                                <div class="yr-dot" aria-hidden="true"></div>
                                <div class="yr-moment-body">
                                    <div class="yr-moment-meta">
                                        <time datetime={m.date}>{m.dateLabel}</time>
                                        <span class="yr-tag">{tagLabels[m.tag]}</span>
                                        {m.contributed && <span class="yr-tag yr-tag-dim">Contributed</span>}
                                        {m.first && <span class="yr-first">✦ {m.first}</span>}
                                    </div>
                                    <h3 class="yr-moment-title">
                                        {m.link ? (
                                            <a href={m.link} target={m.link.startsWith("http") ? "_blank" : undefined} rel={m.link.startsWith("http") ? "noopener noreferrer" : undefined}>
                                                {m.title}
                                            </a>
                                        ) : (
                                            m.title
                                        )}
                                    </h3>
                                    <p class="yr-moment-desc">{m.description}</p>
                                    {m.stat && <span class="yr-stat">{m.stat}</span>}
                                </div>
                                {m.image && (
                                    <a class={`yr-moment-img${m.poster ? " is-poster" : ""}${m.contain ? " is-contain" : ""}`} href={m.link ?? m.image} target={m.link?.startsWith("http") ? "_blank" : undefined} tabindex="-1" aria-hidden="true">
                                        <img src={m.image} alt={m.title} loading="lazy" decoding="async" style={m.imgPos ? `object-position: ${m.imgPos}` : undefined} />
                                    </a>
                                )}
                            </article>
                        ))}

                        {moreByChapter[c.id] && (
                            <details class="yr-more">
                                <summary>
                                    <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 1v10M1 6h10"/></svg>
                                    {moreByChapter[c.id].length} more from this chapter
                                </summary>
                                <div class="yr-more-body">
                                    {moreByChapter[c.id].map((x) => (
                                        <div class="yr-ahead-row">
                                            <span class="yr-ahead-date">{x.date}</span>
                                            <span class="yr-ahead-title yr-more-title">{x.title}</span>
                                            <span class="yr-ahead-note">{x.note}</span>
                                        </div>
                                    ))}
                                </div>
                            </details>
                        )}
                    </section>

                    {quoteAfterChapter[c.id] && (
                        <figure class={`yr-quote yr-quote-${quoteAfterChapter[c.id].align}`} data-reveal>
                            <svg class="yr-quote-star" viewBox="0 0 24 24" aria-hidden="true"><path d={STAR_PATH} fill="currentColor" /></svg>
                            <blockquote>
                                {quoteAfterChapter[c.id].lines.map((l, li) => (
                                    <span class="yr-q-line" style={`--l:${li}`}><span>{l}</span></span>
                                ))}
                            </blockquote>
                            <figcaption>{quoteAfterChapter[c.id].attribution}</figcaption>
                        </figure>
                    )}
                    </>
                ))}
            </div>
        </div>
        </div>

        <!-- ── Firsts ── -->
        <section class="yr-firsts" aria-label="Firsts">
            <h2 class="yr-section-title" data-reveal>A year of firsts</h2>
            <div class="yr-firsts-grid">
                {firsts.map((f, i) => (
                    <div class="yr-first-card" data-reveal style={`--i:${i}`}>
                        <img class="yr-first-bg" src={f.image} alt="" loading="lazy" decoding="async" />
                        <span class="yr-first-star" aria-hidden="true">✦</span>
                        <span class="yr-first-label">{f.label}</span>
                        <span class="yr-first-detail">{f.detail}</span>
                        <span class="yr-first-date">{f.date}</span>
                    </div>
                ))}
            </div>
        </section>

        <!-- ── Film strip ── -->
        <section class="yr-strip" aria-label="Photos from the year">
            <div class="yr-strip-track">
                {[...filmstrip, ...filmstrip].map((p, i) => (
                    <button
                        type="button"
                        class="yr-strip-btn"
                        data-idx={i % filmstrip.length}
                        aria-label={`View photo: ${p.label}`}
                        aria-hidden={i >= filmstrip.length ? "true" : undefined}
                        tabindex={i >= filmstrip.length ? "-1" : undefined}
                    >
                        <img src={p.src} alt="" loading="lazy" decoding="async" />
                    </button>
                ))}
            </div>
        </section>

        <dialog class="yr-lightbox" aria-label="Photo viewer">
            <figure>
                <img alt="" />
                <figcaption>
                    <span class="yr-lb-caption"></span>
                    <span class="yr-lb-count"></span>
                </figcaption>
            </figure>
            <div class="yr-lb-controls">
                <button type="button" class="yr-cta yr-lb-prev" aria-label="Previous photo">←</button>
                <button type="button" class="yr-cta yr-lb-close">Close</button>
                <button type="button" class="yr-cta yr-lb-next" aria-label="Next photo">→</button>
            </div>
        </dialog>

        <!-- ── Charter quote ── -->
        <figure class="yr-quote yr-quote-left yr-quote-charter" data-reveal>
            <svg class="yr-quote-star" viewBox="0 0 24 24" aria-hidden="true"><path d={STAR_PATH} fill="currentColor" /></svg>
            <blockquote>
                {growthQuote.lines.map((l, li) => (
                    <span class="yr-q-line" style={`--l:${li}`}><span>{l}</span></span>
                ))}
            </blockquote>
            <figcaption>{growthQuote.attribution}</figcaption>
        </figure>

        <!-- ── Growth ── -->
        <section class="yr-growth" data-reveal aria-label="Community growth">
            <h2 class="yr-section-title">The line that compounds</h2>
            <p class="yr-growth-sub">
                195 posts, 9,000 likes, an 800+ member community.
            </p>
            <div class="yr-gline-wrap" aria-hidden="true">
                <svg class="yr-gline" viewBox="0 0 800 220" preserveAspectRatio="none">
                    <path class="yr-gline-path" d={growthPath} pathLength="1" />
                    {growth.map((g, i) => (
                        <path
                            class="yr-gline-marker"
                            d={STAR_PATH}
                            style={`--d:${(0.4 + i * 0.4).toFixed(1)}s`}
                            transform={`translate(${gx[i]},${gy[i].toFixed(1)}) scale(0.7) translate(-12,-12)`}
                            data-final={i === growth.length - 1 ? "true" : undefined}
                        />
                    ))}
                </svg>
            </div>
            <div class="yr-growth-row">
                {growth.map((g, i) => (
                    <div class="yr-growth-item">
                        <span class="yr-growth-value" data-count={g.value} data-suffix="" data-idx={i}>0</span>
                        <span class="yr-growth-label">{g.label}</span>
                        <span class="yr-growth-date">{g.date}</span>
                    </div>
                ))}
            </div>
            <div class="yr-pulse">
                <p class="yr-pulse-readout" aria-live="polite">17 months of posting — hover or tab through the bars.</p>
                <div class="yr-pulse-strip">
                    {pulse.map((p, i) => (
                        <button
                            type="button"
                            class="yr-pulse-bar"
                            data-note={`${p.m} · ${p.n} post${p.n === 1 ? "" : "s"}${pulseNote(p.m)}`}
                            aria-label={`${p.m}, ${p.n} posts`}
                            style={`--h:${(p.n / pulseMax).toFixed(3)}; --i:${i}`}
                            data-peak={p.m === "Oct 2025" ? "true" : undefined}
                        ><span></span></button>
                    ))}
                </div>
                <p class="yr-pulse-meta">8,994 likes · 765 comments · 599 shares · posts before Jul 2025 only partially recovered</p>
            </div>
        </section>

        <!-- ── Ahead ── -->
        <section class="yr-ahead" data-reveal aria-label="What comes next">
            <h2 class="yr-section-title">Chapter III is being written</h2>
            <div class="yr-ahead-list">
                {ahead.map((a) => (
                    <div class="yr-ahead-row">
                        <span class="yr-ahead-date">{a.date}</span>
                        <span class="yr-ahead-title">{a.title}</span>
                        <span class="yr-ahead-note">{a.note}</span>
                    </div>
                ))}
            </div>
        </section>

        <!-- ── Constellation ── -->
        <section class="yr-sky" data-reveal aria-label="Every event of year one, as a constellation">
            <svg class="yr-sky-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                {constellationLines.map(([a, b], i) => (
                    <line
                        x1={constellation[a].x} y1={constellation[a].y + 10}
                        x2={constellation[b].x} y2={constellation[b].y + 10}
                        pathLength="1"
                        style={`--d:${(0.8 + i * 0.07).toFixed(2)}s`}
                    />
                ))}
                <line x1="94" y1="84" x2="96.5" y2="16" pathLength="1" style="--d:2s" class="yr-sky-reach" />
            </svg>
            {constellation.map((s, i) => (
                <button
                    type="button"
                    class="yr-sky-star"
                    style={`left:${s.x}%; top:${s.y + 10}%; --i:${i}`}
                    aria-label={`${s.label} · ${s.date}`}
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={STAR_PATH} fill="currentColor" /></svg>
                    <span class="yr-sky-label">{s.label}<em>{s.date}</em></span>
                </button>
            ))}
            <button type="button" class="yr-sky-star yr-sky-north" style="left:96.5%; top:16%; --i:27" aria-label="North Star — the community itself">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={STAR_PATH} fill="currentColor" /></svg>
                <span class="yr-sky-label">North Star<em>the line itself</em></span>
            </button>
            <div class="yr-sky-quote">
                {closingQuote.lines.map((l, li) => (
                    <span class="yr-q-line" style={`--l:${li}`}><span>{l}</span></span>
                ))}
                <span class="yr-sky-attr">{closingQuote.attribution}</span>
            </div>
        </section>

        <!-- ── CTAs ── -->
        <section class="yr-close" data-reveal>
            <div class="yr-cta-row">
                <a class="yr-cta" href="https://discord.gg/m5Hknymurb" target="_blank" rel="noopener noreferrer">
                    Join the community <ArrowRight className="w-3.5 h-3.5" />
                </a>
                <a class="yr-cta" href="/work-with-us">
                    Partner with us <ArrowRight className="w-3.5 h-3.5" />
                </a>
                <a class="yr-cta" href="/events">
                    See all events <ArrowRight className="w-3.5 h-3.5" />
                </a>
                <button type="button" class="yr-cta yr-share">
                    <span class="yr-swap">
                        <span class="yr-swap-a">Share year one</span>
                        <span class="yr-swap-b">Link copied</span>
                    </span>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
                </button>
            </div>
            <div class="yr-share-live" aria-live="polite"></div>
        </section>
    </main>
</Layout>

<script is:inline define:vars={{ stripData: filmstrip, filterNouns, tagCounts }}>
    (function () {
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        /* ── Reveal observer ── */
        var reveal = new IntersectionObserver(
            function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-revealed");
                        reveal.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.1 }
        );
        document.querySelectorAll("[data-reveal]").forEach(function (el) {
            reveal.observe(el);
        });

        /* ── Animated counters (staggered, with settle pop) ── */
        var fmt = function (n) { return n.toLocaleString("en-US"); };
        var counters = new IntersectionObserver(
            function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    counters.unobserve(entry.target);
                    var el = entry.target;
                    var target = parseInt(el.dataset.count, 10);
                    var suffix = el.dataset.suffix || "";
                    if (reduced) {
                        el.textContent = fmt(target) + suffix;
                        return;
                    }
                    var delay = (parseInt(el.dataset.idx || "0", 10)) * 120;
                    setTimeout(function () {
                        var start = null;
                        var dur = 1400;
                        var step = function (ts) {
                            if (!start) start = ts;
                            var p = Math.min((ts - start) / dur, 1);
                            var eased = 1 - Math.pow(1 - p, 3);
                            el.textContent = fmt(Math.round(target * eased)) + suffix;
                            if (p < 1) requestAnimationFrame(step);
                            else el.classList.add("is-settled");
                        };
                        requestAnimationFrame(step);
                    }, delay);
                });
            },
            { threshold: 0.5 }
        );
        document.querySelectorAll("[data-count]").forEach(function (el) {
            counters.observe(el);
        });

        /* ── Scroll engine: one listener, a registry of subscribers ── */
        var timeline = document.getElementById("yr-timeline");
        var star = document.querySelector(".yr-line-star");
        var trail = document.querySelector(".yr-line-trail");
        var dots = [];
        var dotOffsets = [];
        var parallaxEls = [];
        var heroGhost = document.querySelector("[data-hero-ghost]");
        var heroEl = document.querySelector(".yr-hero");

        function cacheDots() {
            if (!timeline) return;
            var tlTop = timeline.getBoundingClientRect().top + window.scrollY;
            dots = Array.prototype.slice
                .call(timeline.querySelectorAll(".yr-moment:not(.is-hidden) .yr-dot"));
            dotOffsets = dots.map(function (d) {
                return d.getBoundingClientRect().top + window.scrollY - tlTop;
            });
        }

        var heroH = 1;
        function cacheParallax() {
            if (heroEl) heroH = heroEl.offsetHeight || 1;
            parallaxEls = Array.prototype.slice
                .call(document.querySelectorAll("[data-parallax]"))
                .map(function (el) {
                    el.style.transform = "";
                    var r = el.getBoundingClientRect();
                    return {
                        el: el,
                        factor: parseFloat(el.dataset.parallax),
                        center: r.top + window.scrollY + r.height / 2,
                    };
                });
        }

        var ticking = false;
        function frame() {
            ticking = false;
            var vh = window.innerHeight;
            var sy = window.scrollY;

            if (timeline && star && trail) {
                var rect = timeline.getBoundingClientRect();
                var progress = Math.min(Math.max((vh * 0.45 - rect.top) / rect.height, 0), 1);
                star.style.transform =
                    "translateY(" + progress * (rect.height - 28) + "px) translateX(-50%)";
                trail.style.transform = "scaleY(" + progress + ")";
                var passed = progress * rect.height;
                for (var i = 0; i < dots.length; i++) {
                    dots[i].classList.toggle("is-lit", dotOffsets[i] <= passed);
                }
            }

            for (var j = 0; j < parallaxEls.length; j++) {
                var p = parallaxEls[j];
                var y = (sy + vh / 2 - p.center) * p.factor;
                p.el.style.transform = "translate3d(0," + y.toFixed(1) + "px,0)";
            }

            if (heroGhost && heroEl) {
                var fade = 1 - Math.min(Math.max(sy / (heroH * 0.9), 0), 1);
                heroGhost.style.opacity = String((0.9 * fade).toFixed(2));
            }
        }

        if (!reduced) {
            window.addEventListener(
                "scroll",
                function () {
                    if (!ticking) {
                        ticking = true;
                        requestAnimationFrame(frame);
                    }
                },
                { passive: true }
            );
            window.addEventListener("resize", function () {
                cacheDots();
                cacheParallax();
                requestAnimationFrame(frame);
            }, { passive: true });
            cacheDots();
            cacheParallax();
            frame();
        }

        /* Ledger open/close changes timeline height — recache */
        document.querySelectorAll(".yr-more").forEach(function (d) {
            d.addEventListener("toggle", function () {
                setTimeout(function () {
                    cacheDots();
                    cacheParallax();
                    requestAnimationFrame(frame);
                }, 450);
            });
        });
        /* Reveal transforms settle shortly after load — recache once */
        setTimeout(function () {
            cacheDots();
            cacheParallax();
            if (!reduced) requestAnimationFrame(frame);
        }, 1500);

        /* ── Filters: FLIP reflow, readout, URL state ── */
        var chips = document.querySelectorAll(".yr-chip");
        var readout = document.querySelector(".yr-filter-readout");
        var moments = Array.prototype.slice.call(document.querySelectorAll(".yr-moment"));

        function updateMeta(key) {
            var count = tagCounts[key] || 0;
            if (readout) {
                readout.textContent = key === "all"
                    ? "Showing all " + count + " moments across three chapters."
                    : "Showing " + count + " " + (filterNouns[key] || "moments") + " across three chapters.";
            }
            document.querySelectorAll(".yr-chapter").forEach(function (ch) {
                var any = ch.querySelector(".yr-moment:not(.is-hidden)");
                var head = ch.querySelector(".yr-chapter-head");
                if (head) head.classList.toggle("is-thinned", !any);
            });
            if (key === "all") history.replaceState(null, "", location.pathname + location.hash);
            else history.replaceState(null, "", "?filter=" + key + location.hash);
        }

        function setChip(chip) {
            chips.forEach(function (c) {
                c.setAttribute("aria-pressed", c === chip ? "true" : "false");
            });
        }

        function applyFilterInstant(key) {
            moments.forEach(function (m) {
                m.classList.toggle("is-hidden", !(key === "all" || m.dataset.tag === key));
            });
            updateMeta(key);
            cacheDots();
            cacheParallax();
        }

        var filtering = false;
        function applyFilterFlip(key) {
            if (filtering) return;
            filtering = true;
            var visible = moments.filter(function (m) { return !m.classList.contains("is-hidden"); });
            var firstTops = new Map();
            visible.forEach(function (m) { firstTops.set(m, m.getBoundingClientRect().top); });

            var show = function (m) { return key === "all" || m.dataset.tag === key; };
            var leaving = visible.filter(function (m) { return !show(m); });
            leaving.forEach(function (m) { m.classList.add("is-leaving"); });

            setTimeout(function () {
                leaving.forEach(function (m) {
                    m.classList.add("is-hidden");
                    m.classList.remove("is-leaving");
                });
                var entering = [];
                moments.forEach(function (m) {
                    if (show(m) && m.classList.contains("is-hidden")) {
                        m.classList.remove("is-hidden");
                        if (!firstTops.has(m)) entering.push(m);
                    }
                });
                entering.forEach(function (m) {
                    m.style.transition = "none";
                    m.style.opacity = "0";
                });
                var staying = moments.filter(function (m) { return show(m) && firstTops.has(m); });
                staying.forEach(function (m) {
                    var delta = firstTops.get(m) - m.getBoundingClientRect().top;
                    if (Math.abs(delta) > 2) {
                        m.style.transition = "none";
                        m.style.transform = "translateY(" + delta + "px)";
                    }
                });
                requestAnimationFrame(function () {
                    requestAnimationFrame(function () {
                        staying.forEach(function (m) {
                            m.style.transition = "transform .45s cubic-bezier(0.16,1,0.3,1)";
                            m.style.transform = "";
                        });
                        entering.forEach(function (m) {
                            m.style.transition = "opacity .45s cubic-bezier(0.16,1,0.3,1)";
                            m.style.opacity = "";
                        });
                    });
                });
                setTimeout(function () {
                    moments.forEach(function (m) {
                        m.style.transition = "";
                        m.style.transform = "";
                        m.style.opacity = "";
                    });
                    updateMeta(key);
                    cacheDots();
                    cacheParallax();
                    requestAnimationFrame(frame);
                    filtering = false;
                }, 500);
            }, 250);
        }

        chips.forEach(function (chip) {
            chip.addEventListener("click", function () {
                if (filtering) return;
                setChip(chip);
                var key = chip.dataset.filter;
                if (reduced) applyFilterInstant(key);
                else applyFilterFlip(key);
            });
        });

        /* Restore filter from URL */
        var urlFilter = new URLSearchParams(location.search).get("filter");
        if (urlFilter && tagCounts[urlFilter]) {
            var target = document.querySelector('.yr-chip[data-filter="' + urlFilter + '"]');
            if (target) {
                setChip(target);
                applyFilterInstant(urlFilter);
            }
        }

        /* ── Active chapter in the rail ── */
        var railLinks = document.querySelectorAll("[data-rail]");
        var chapterObs = new IntersectionObserver(
            function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    var id = entry.target.dataset.chapter;
                    railLinks.forEach(function (l) {
                        l.classList.toggle("is-active", l.dataset.rail === id);
                    });
                });
            },
            { rootMargin: "-30% 0px -60% 0px" }
        );
        document.querySelectorAll("[data-chapter]").forEach(function (s) {
            chapterObs.observe(s);
        });

        /* ── Lightbox ── */
        var lightbox = document.querySelector(".yr-lightbox");
        if (lightbox && typeof lightbox.showModal === "function") {
            var lbImg = lightbox.querySelector("img");
            var lbCaption = lightbox.querySelector(".yr-lb-caption");
            var lbCount = lightbox.querySelector(".yr-lb-count");
            var track = document.querySelector(".yr-strip-track");
            var lbIdx = 0;
            var lastTrigger = null;

            function lbShow(idx, animate) {
                lbIdx = (idx + stripData.length) % stripData.length;
                var item = stripData[lbIdx];
                var swap = function () {
                    lbImg.src = item.src;
                    lbCaption.textContent = item.label;
                    lbCount.textContent = (lbIdx + 1) + " / " + stripData.length;
                };
                if (animate && !reduced) {
                    lbImg.classList.remove("is-in");
                    swap();
                    requestAnimationFrame(function () {
                        requestAnimationFrame(function () { lbImg.classList.add("is-in"); });
                    });
                } else {
                    swap();
                    lbImg.classList.add("is-in");
                }
                [lbIdx - 1, lbIdx + 1].forEach(function (n) {
                    var pre = new Image();
                    pre.src = stripData[(n + stripData.length) % stripData.length].src;
                });
            }

            document.querySelectorAll(".yr-strip-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    lastTrigger = btn;
                    lbShow(parseInt(btn.dataset.idx, 10), false);
                    lightbox.showModal();
                    if (track) track.classList.add("is-paused");
                });
            });

            lightbox.querySelector(".yr-lb-prev").addEventListener("click", function () { lbShow(lbIdx - 1, true); });
            lightbox.querySelector(".yr-lb-next").addEventListener("click", function () { lbShow(lbIdx + 1, true); });
            lightbox.querySelector(".yr-lb-close").addEventListener("click", function () { lightbox.close(); });
            lightbox.addEventListener("keydown", function (e) {
                if (e.key === "ArrowLeft") { e.preventDefault(); lbShow(lbIdx - 1, true); }
                if (e.key === "ArrowRight") { e.preventDefault(); lbShow(lbIdx + 1, true); }
            });
            var justSwiped = false;
            lightbox.addEventListener("click", function (e) {
                if (justSwiped) return;
                if (e.target === lightbox) lightbox.close();
            });
            lightbox.addEventListener("close", function () {
                if (track) track.classList.remove("is-paused");
                if (lastTrigger) lastTrigger.focus();
            });
            var swipeX = null;
            lightbox.addEventListener("pointerdown", function (e) { swipeX = e.clientX; });
            lightbox.addEventListener("pointerup", function (e) {
                if (swipeX === null) return;
                var dx = e.clientX - swipeX;
                if (Math.abs(dx) > 40) {
                    justSwiped = true;
                    setTimeout(function () { justSwiped = false; }, 150);
                    lbShow(lbIdx + (dx > 40 ? -1 : 1), true);
                }
                swipeX = null;
            });
        }

        /* ── Constellation: tap/click toggles labels ── */
        var openStar = null;
        document.querySelectorAll(".yr-sky-star").forEach(function (starBtn) {
            starBtn.setAttribute("aria-expanded", "false");
            starBtn.addEventListener("click", function () {
                var isOpen = starBtn.classList.contains("is-open");
                if (openStar) {
                    openStar.classList.remove("is-open");
                    openStar.setAttribute("aria-expanded", "false");
                }
                if (!isOpen) {
                    starBtn.classList.add("is-open");
                    starBtn.setAttribute("aria-expanded", "true");
                    openStar = starBtn;
                } else {
                    openStar = null;
                }
            });
        });

        /* ── Pulse readout ── */
        var pulseReadout = document.querySelector(".yr-pulse-readout");
        document.querySelectorAll(".yr-pulse-bar").forEach(function (bar) {
            bar.addEventListener("mouseenter", function () {
                if (pulseReadout) pulseReadout.textContent = bar.dataset.note;
            });
        });

        /* ── Share + chapter anchors ── */
        function legacyCopy(text) {
            return new Promise(function (resolve, reject) {
                var input = document.createElement("input");
                input.readOnly = true;
                input.value = text;
                input.style.position = "fixed";
                input.style.opacity = "0";
                document.body.appendChild(input);
                input.select();
                var ok = document.execCommand("copy");
                document.body.removeChild(input);
                ok ? resolve() : reject();
            });
        }

        function copyText(text) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                return navigator.clipboard.writeText(text).catch(function () {
                    return legacyCopy(text);
                });
            }
            return legacyCopy(text);
        }

        function flashSwap(el, live, message) {
            el.classList.add("is-done");
            if (live) live.textContent = message;
            setTimeout(function () {
                el.classList.remove("is-done");
                if (live) live.textContent = "";
            }, 1500);
        }

        var shareBtn = document.querySelector(".yr-share");
        var shareLive = document.querySelector(".yr-share-live");
        if (shareBtn) {
            shareBtn.addEventListener("click", function () {
                var url = location.origin + location.pathname;
                if (navigator.share && window.matchMedia("(pointer: coarse)").matches) {
                    navigator.share({ title: "North Star — Year One", url: url }).catch(function () {});
                } else {
                    copyText(url).then(function () {
                        flashSwap(shareBtn, shareLive, "Link copied to clipboard");
                    }).catch(function () {});
                }
            });
        }

        document.querySelectorAll(".yr-anchor").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var url = location.origin + location.pathname + "#" + btn.dataset.anchor;
                copyText(url).then(function () {
                    flashSwap(btn, shareLive, "Chapter link copied to clipboard");
                }).catch(function () {});
            });
        });
    })();
</script>

